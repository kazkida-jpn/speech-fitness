{
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.1.8",
      "includeFiles": "dist/server/**"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!billing/|social/|assessment$|diagnosis$).*)",
      "has": [
        {
          "type": "host",
          "value": "speech-fitness-rouge.vercel.app"
        }
      ],
      "destination": "https://speech-fitness.learn-k.net/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assessment",
      "destination": "/api/index"
    },
    {
      "source": "/diagnosis",
      "destination": "/api/index"
    },
    {
      "source": "/billing/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/social/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/check",
      "destination": "/check.html"
    },
    {
      "source": "/drills",
      "destination": "/drills.html"
    },
    {
      "source": "/history",
      "destination": "/history.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/welcome",
      "destination": "/welcome.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/legal",
      "destination": "/legal.html"
    }
  ],
  "crons": [
    {
      "path": "/social/publish",
      "schedule": "0 0 * * 1,3,5"
    }
  ]
}
