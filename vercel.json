{
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.1.8",
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/assessment",
      "destination": "/api/index"
    },
    {
      "source": "/diagnosis",
      "destination": "/api/index"
    },
    {
      "source": "/check",
      "destination": "/check.html"
    },
    {
      "source": "/drills",
      "destination": "/drills.html"
    },
    {
      "source": "/history",
      "destination": "/history.html"
    }
  ]
}
